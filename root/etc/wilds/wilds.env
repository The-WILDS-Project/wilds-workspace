# Environment shared by the WILDS services. Edit, then: systemctl restart wilds.target
# Keep this file root-owned and mode 0640 (group wilds): it holds the GUI secret key.

# wilds-gui
WILDS_GUI_DEBUG=0
WILDS_GUI_SECRET_KEY=change-me
WILDS_GUI_ALLOWED_HOSTS=localhost,127.0.0.1
WILDS_CONTROL_URL=http://localhost:8001
