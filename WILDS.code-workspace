{
  "folders": [
    {
      "path": "../wilds-control"
    },
    {
      "path": "../wilds-bridge"
    },
    {
      "path": "../wilds-science-camera"
    },
    {
      "path": "../wilds-solving"
    },
    {
      "path": "../wilds-claude"
    },
    {
      "path": "../.wilds-vault"
    },
    {
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true
    },
    "search.exclude": {
      "**/.venv": true,
      "**/uv.lock": true
    },
    "python.terminal.activateEnvironment": true,
    "python.defaultInterpreterPath": "${workspaceFolder}/../.venv/bin/python",
    "ruff.exclude": [
      "**/.venv/**",
      "**/site-packages/**"
    ],
    "[python]": {
      "editor.codeActionsOnSave": {
        "source.organizeImports.ruff": "explicit"
      }
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "charliermarsh.ruff"
    ]
  }
}
